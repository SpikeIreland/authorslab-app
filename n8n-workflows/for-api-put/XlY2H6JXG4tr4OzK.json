        "mode": "runOnceForEachItem",
        "jsCode": "const ch = $input.item.json;\n\nconst systemPrompt = `You are Alex, a developmental editor creating reference summaries. Create a concise 2-3 sentence summary that captures what happens in this chapter and why it matters to the overall story arc.  Focus on: key events, character decisions, and story progression.`;\n\nconst userPrompt = `Chapter ${ch.chapter_number}: \"${ch.title}\"\n\nContent:\n${ch.content}\n\nProvide a 2-3 sentence summary that captures the essential events and character developments. Return ONLY the summary text, no preamble or explanation.`;\n\nreturn { json: { system: systemPrompt, user: userPrompt, chapter_id: ch.id, chapter_number: ch.chapter_number } };"
      },
