    {
      "parameters": {
        "jsCode": "try {\n    // Get the data from previous nodes\n    const authorData = $('Get Author Details').first().json;\n    const manuscriptData = $('Create Initial Manuscript').first().json;\n\n    // Create the proper response structure\n    const responseData = {\n        success: true,\n        onboardingComplete: true,\n        userId: authorData.id,\n        manuscriptId: manuscriptData.id,\n        manuscriptCreated: true,\n        phasesInitialized: true,\n        redirectTo: `/author-login/author-dashboard/?userId=${authorData.id}`,\n        message: \"Portal setup complete! Your 4-phase editing system is ready.\"\n    };\n\n    return [responseData];\n} catch (error) {\n    // Return error response\n    return [{\n        success: false,\n        error: error.message,\n        message: \"There was an issue setting up your account. Please try again.\"\n    }];\n}"
      },
