      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO manuscripts (\n  id, author_id, title, genre, full_text, original_upload_text,\n  current_word_count, total_chapters, has_prologue, has_epilogue,\n  status, current_phase_number, created_at, updated_at\n) VALUES (\n  $1, $2, $3, $4, $5, $5, $6, $7, $8, $9, 'uploaded', 1, NOW(), NOW()\n)\nON CONFLICT (id) DO UPDATE SET\n  author_id = $2, title = $3, genre = $4, full_text = $5,\n  original_upload_text = $5, current_word_count = $6,\n  total_chapters = $7, has_prologue = $8, has_epilogue = $9,\n  updated_at = NOW()\nRETURNING id, title, genre, current_word_count, status;",
        "options": {
          "queryReplacement": "={{ [\n  $('Webhook').first().json.body.manuscriptId,                    // $1 - id\n  $('Get Author Details').first().json.id,                        // $2 - author_id\n  $('Webhook').first().json.body.manuscriptTitle,                 // $3 - title\n  $('Webhook').first().json.body.genre,                           // $4 - genre\n  $('Webhook').first().json.body.manuscriptText,                  // $5 - full_text & original_upload_text\n  $('Webhook').first().json.body.wordCount,                       // $6 - current_word_count\n  $('Webhook').first().json.body.expectedChapters || 0,           // $7 - total_chapters\n  $('Webhook').first().json.body.hasPrologue || false,            // $8 - has_prologue\n  $('Webhook').first().json.body.hasEpilogue || false             // $9 - has_epilogue\n] }}"
        }
