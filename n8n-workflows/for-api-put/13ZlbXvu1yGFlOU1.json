    {
      "parameters": {
        "jsCode": "// Escape single quotes for SQL\nconst manuscriptText = $(\"Extract Data\").item.json.manuscriptText || '';\nconst manuscriptTitle = $(\"Extract Data\").item.json.manuscriptTitle || 'Untitled Manuscript';\n\n// Replace single quotes with two single quotes (SQL escape)\nconst escapedText = manuscriptText.replace(/'/g, \"''\");\nconst escapedTitle = manuscriptTitle.replace(/'/g, \"''\");\n\nreturn [{\n  json: {\n    manuscriptId: $(\"Create Initial Manuscript\").item.json.id,\n    escapedText: escapedText,\n    escapedTitle: escapedTitle,\n    wordCount: $(\"Extract Data\").item.json.wordCount || 0\n  }\n}];"
      },
