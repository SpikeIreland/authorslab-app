        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          0,
          -16
        ],
        "id": "8c51f571-f4e5-4d49-9348-b8e05db1af51",
        "name": "Webhook",
        "webhookId": "72c20f6d-c6a7-4da0-8282-be990dbec454"
      },
      {
        "parameters": {
          "jsCode": "const data = $json.body || $json;\n\nconst manuscriptId = data.manuscriptId;\nconst genre = data.genre || 'Fiction';\nconst mood = data.mood || 'atmospheric';\nconst colors = data.colors || '';\nconst elements = data.elements || '';\nconst title = data.manuscriptTitle || 'the book';\n\n// Base prompt template\nconst basePrompt = `Professional book cover design for a ${genre} novel. ${mood} atmosphere. ${elements}. ${colors}. High quality, detailed, cinematic composition. Space for title text at top. No text, no letters, no words. Cover design only.`;\n\n// Generate 4 variations\nconst variations = [\n  `${basePrompt} Landscape orientation, dramatic lighting.`,\n  `${basePrompt} Portrait orientation, soft focus background.`,\n  `${basePrompt} Detailed composition, intense colors.`,\n  `${basePrompt} Wide environmental view, epic scale.`\n];\n\n// Return array of items - one per prompt\nreturn variations.map((prompt, index) => ({\n  manuscriptId,\n  manuscriptTitle: title,\n  genre,\n  prompt: prompt,\n  promptIndex: index + 1,\n  timestamp: new Date().toISOString()\n}));"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          432,
          -16
        ],
        "id": "0a871645-eef9-40b9-859b-902202a292ab",
        "name": "Prepare Cover Prompts"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.openai.com/v1/images/generations",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "Bearer <REMOVED - recreate as OpenAI credential in authorslab>"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"model\": \"dall-e-3\",\n  \"prompt\": \"={{ $json.prompt }}\",\n  \"n\": 1,\n  \"size\": \"1024x1024\",\n  \"quality\": \"standard\",\n  \"response_format\": \"url\"\n}",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          880,
          -16
        ],
        "id": "b1bb9f14-823f-4ca0-a5d6-ff5a12e4d8fe",
        "name": "Call DALL-E 3"
      },
      {
        "parameters": {
          "url": "={{ $json.data[0].url }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "User-Agent",
                "value": "Mozilla/5.0\""
              },
              {
                "name": "Accept",
                "value": "image/png,image/*,*/*"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true,
                "responseFormat": "file"
              }
            },
            "timeout": 120000
          }
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1328,
          -16
        ],
        "id": "66f73017-c57c-473b-bc35-c96be4a5fdea",
        "name": "Download Image",
        "retryOnFail": true,
        "waitBetweenTries": 5000,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "// Get the binary data from Download Image\nconst binaryData = $input.first().binary;\n\n// Get manuscriptId from Webhook (most reliable)\nconst manuscriptId = $(\"Webhook\").first().json.body.manuscriptId;\n\n// Get current item from the loop - use itemIndex from Split In Batches\nconst loopNode = $(\"Loop Over Items\");\nconst currentRunIndex =\n  loopNode.first().json.index !== undefined\n    ? loopNode.first().json.index\n    : $runIndex || 0;\n\n// Get the matching prompt from Prepare Cover Prompts\nconst allPrompts = $(\"Prepare Cover Prompts\").all();\nconst currentPrompt = allPrompts[currentRunIndex]?.json || allPrompts[0]?.json;\nconst coverIndex = currentPrompt.promptIndex || currentRunIndex + 1;\n\nconsole.log(\"\ud83d\udcc1 Preparing storage:\", {\n  manuscriptId,\n  coverIndex,\n  currentRunIndex,\n});\n\nreturn {\n  json: {\n    manuscriptId: manuscriptId,\n    fileName: `cover-${coverIndex}.png`,\n    storagePath: `${manuscriptId}/cover-${coverIndex}.png`,\n    prompt: currentPrompt.prompt || \"Generated cover\",\n    coverIndex: coverIndex,\n  },\n  binary: binaryData,\n};\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1776,
          -16
        ],
        "id": "6c61ab03-047d-4b42-9c59-bcfb6f21d1a2",
        "name": "Prepare for Storage"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://itlkncjiifbgvmvuejgm.supabase.co/storage/v1/object/manuscript-covers/{{ $json.storagePath }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "Bearer <REMOVED - recreate as Supabase Service Key credential in authorslab>"
              },
              {
                "name": "Content-Type",
                "value": "image/png"
              },
              {
                "name": "x-upsert",
                "value": "true"
              }
            ]
          },
          "sendBody": true,
          "contentType": "binaryData",
          "inputDataFieldName": "data",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2000,
          -16
        ],
        "id": "8e4cb4ec-a689-4321-aaf0-475216b1d8a8",
        "name": "Upload to Supabase Storage",
        "retryOnFail": true,
        "waitBetweenTries": 5000,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const uploadResponse = $input.first().json;\nconst storageData = $(\"Prepare for Storage\").first().json;\n\n// Get the current iteration index from the loop\nconst allPreparedItems = $(\"Prepare for Storage\").all();\nconst currentItemIndex = allPreparedItems.findIndex(\n  (item) => item.json.storagePath === storageData.storagePath,\n);\nconst coverIndex =\n  currentItemIndex >= 0 ? currentItemIndex + 1 : storageData.coverIndex || 1;\n\n// Construct public URL\nconst publicUrl = `https://itlkncjiifbgvmvuejgm.supabase.co/storage/v1/object/public/manuscript-covers/${storageData.storagePath}`;\n\nreturn {\n  id: coverIndex,\n  url: publicUrl,\n  prompt: storageData.prompt,\n  selected: false,\n  created_at: new Date().toISOString(),\n};\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2224,
