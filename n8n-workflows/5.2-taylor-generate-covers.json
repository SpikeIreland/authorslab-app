        "id": "0ea4623e-280c-40cc-a42c-ffe0da16fa4d",
        "name": "Update Publishing Progress"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO editor_chat_history (\n  manuscript_id,\n  phase_number,\n  sender,\n  message\n) VALUES (\n  $1,\n  4,\n  'Taylor',\n  '\ud83c\udfa8 Your cover designs are ready! I''ve generated 4 professional concepts based on your genre and preferences. Click the \"Cover Designer\" panel above to view them. Take your time choosing - you can always ask me to generate more variations if needed!'\n)\nRETURNING *;",
          "options": {
