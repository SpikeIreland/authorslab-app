        "id": "1c2f915f-dda1-42ef-a698-f09a575cae22",
        "name": "Collect All Covers"
      },
      {
        "parameters": {
          "jsCode": "const inputData = $input.first().json;\nconst covers = inputData.data || [];\n\n// Get manuscriptId from Webhook (most reliable source)\nconst manuscriptId = $('Webhook').first().json.body.manuscriptId;\n\nconsole.log('\ud83d\udce6 Building final update:', {\n  manuscriptId,\n  coversCount: covers.length\n});\n\nreturn {\n  manuscriptId,\n  coverConcepts: covers,\n  totalCovers: covers.length,\n  completedAt: new Date().toISOString()\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1104,
          -208
        ],
        "id": "7ff377bf-9d34-4042-8b8b-d4ffbb90311b",
        "name": "Build Final Update"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE publishing_progress\nSET \n  cover_concepts = $1::jsonb,\n  cover_generation_status = 'complete',\n  updated_at = NOW()\nWHERE manuscript_id = $2\nRETURNING *;",
          "options": {
            "queryReplacement": "={{ [ JSON.stringify($json.coverConcepts), $json.manuscriptId ] }}"
          }
        },
        "type": "n8n-nodes-base.postgres",
